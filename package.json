{
  "name": "bz-review",
  "version": "1.0.2",
  "description": "复习 · 把要记住的笔记和划线排进复习计划（Obsidian 插件）",
  "main": "src/main.ts",
  "author": "叫我包仔",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeshimei/bz-review.git"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "once": "node esbuild.config.mjs once",
    "test": "vitest run",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint:css": "node scripts/lint-css.mjs",
    "lint:tooltip": "node scripts/check-tooltip-attrs.mjs",
    "lint:obsidian": "node scripts/lint-obsidian.mjs",
    "lint": "npm run lint:css && npm run lint:tooltip && npm run lint:obsidian"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.21.5",
    "jsdom": "^30.0.1",
    "obsidian": "1.14.4",
    "typescript": "^5.4.5",
    "vite": "^6.0.0",
    "vitest": "^5.0.3"
  }
}
